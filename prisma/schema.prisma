generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Auth & RBAC ───────────────────────────────────────────────

model User {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  email        String  @unique
  password     String
  name         String
  mobileNumber String?
  profileImage String? @db.MediumText
  isActive     Boolean @default(true)

  defaultCompanyId Int
  roleId           Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role                         Role                   @relation(fields: [roleId], references: [id])
  defaultCompany               Company                @relation("DefaultCompany", fields: [defaultCompanyId], references: [id])
  userCompanies                UserCompany[]
  menuAccess                   UserMenuAccess[]
  loginHistory                 LoginHistory[]
  createdInvoices              Invoice[]              @relation("CreatedInvoices")
  deletedInvoices              Invoice[]              @relation("DeletedInvoices")
  purchaseOrders               PurchaseOrder[]        @relation("CreatedPO")
  approvedPOs                  PurchaseOrder[]        @relation("ApprovedPO")
  createdGRNs                  GoodsReceipt[]
  createdPayments              VendorPayment[]        @relation("CreatedVendorPayments")
  updatedPayments              VendorPayment[]        @relation("UpdatedVendorPayments")
  createdInvoicePayments       InvoicePayment[]
  createdKitchenOrders         KitchenOrder[]         @relation("CreatedKitchenOrders")
  createdPurchaseInvoices      PurchaseInvoice[]
  createdStockOuts             StockOut[]
  createdAudits                StockAudit[]
  createdIndents               Indent[]
  createdEstimates             Estimate[]             @relation("CreatedEstimates")
  createdVendorBranchMappings  VendorBranchMapping[]  @relation("CreatedVendorBranchMappings")
  createdUnits                 Unit[]                 @relation("CreatedUnits")
  createdExpenseCategories     ExpenseCategory[]      @relation("CreatedExpenseCategories")
  createdStudents              Student[]              @relation("CreatedStudents")
  updatedStudents              Student[]              @relation("UpdatedStudents")
  createdCustomers             Customer[]             @relation("CreatedCustomers")
  updatedCustomers             Customer[]             @relation("UpdatedCustomers")
  createdVendors               Vendor[]               @relation("CreatedVendors")
  updatedVendors               Vendor[]               @relation("UpdatedVendors")
  createdProductionMappings    ProductionMapping[]    @relation("CreatedProductionMappings")
  updatedProductionMappings    ProductionMapping[]    @relation("UpdatedProductionMappings")
  createdProductionConversions ProductionConversion[] @relation("CreatedProductionConversions")
  updatedProductionConversions ProductionConversion[] @relation("UpdatedProductionConversions")
  createdBranches              Branch[]               @relation("CreatedBranches")
  updatedBranches              Branch[]               @relation("UpdatedBranches")
  createdHsnSacs               HSNSac[]               @relation("CreatedHSNSacs")
  updatedHsnSacs               HSNSac[]               @relation("UpdatedHSNSacs")
  createdCompanies             Company[]              @relation("CreatedCompanies")
  updatedCompanies             Company[]              @relation("UpdatedCompanies")
  createdExpenses              Expense[]              @relation("CreatedExpenses")
  updatedExpenses              Expense[]              @relation("UpdatedExpenses")
  closedDayClosings            DayClosing[]           @relation("ClosedDayClosings")
  createdDayClosings           DayClosing[]           @relation("CreatedDayClosings")
  updatedDayClosings           DayClosing[]           @relation("UpdatedDayClosings")
  createdAdvanceOrders         AdvanceOrder[]         @relation("CreatedAdvanceOrders")
  updatedAdvanceOrders         AdvanceOrder[]         @relation("UpdatedAdvanceOrders")
  createdProductionPlans       ProductionPlan[]       @relation("CreatedProductionPlans")
  updatedProductionPlans       ProductionPlan[]       @relation("UpdatedProductionPlans")
  createdProductionIns         ProductionIn[]         @relation("CreatedProductionIns")
  updatedProductionIns         ProductionIn[]         @relation("UpdatedProductionIns")
  createdProductionOuts        ProductionOut[]        @relation("CreatedProductionOuts")
  updatedProductionOuts        ProductionOut[]        @relation("UpdatedProductionOuts")
  createdWastages              Wastage[]              @relation("CreatedWastages")
  updatedWastages              Wastage[]              @relation("UpdatedWastages")
  createdWAMessages            WAMessage[]            @relation("CreatedWAMessages")
  createdWATemplates           WATemplate[]           @relation("CreatedWATemplates")
  updatedWATemplates           WATemplate[]           @relation("UpdatedWATemplates")
  createdWACampaigns           WACampaign[]           @relation("CreatedWACampaigns")
  updatedWACampaigns           WACampaign[]           @relation("UpdatedWACampaigns")
  createdCashCategories        CashCategory[]         @relation("CreatedCashCategories")
  updatedCashCategories        CashCategory[]         @relation("UpdatedCashCategories")
  createdCashAccounts          CashAccount[]          @relation("CreatedCashAccounts")
  updatedCashAccounts          CashAccount[]          @relation("UpdatedCashAccounts")
  createdCashTransactions      CashTransaction[]      @relation("CreatedCashTransactions")
  updatedCashTransactions      CashTransaction[]      @relation("UpdatedCashTransactions")
  billLockedProducts           Product[]              @relation("BillLockedProducts")
  onlineLockedProducts         Product[]              @relation("OnlineLockedProducts")
  createdPaymentSettings       PaymentSettings[]      @relation("CreatedPaymentSettings")
  updatedPaymentSettings       PaymentSettings[]      @relation("UpdatedPaymentSettings")
  walletTransactions           WalletTransaction[]
  createdQuotes                Quote[]                @relation("CreatedQuotes")
  updatedQuotes                Quote[]                @relation("UpdatedQuotes")
  createdAccountingInvoices    AccountingInvoice[]    @relation("CreatedAccountingInvoices")
  updatedAccountingInvoices    AccountingInvoice[]    @relation("UpdatedAccountingInvoices")
  createdEvents                Event[]                @relation("CreatedEvents")
  updatedEvents                Event[]                @relation("UpdatedEvents")
  createdBackups               BackupHistory[]        @relation("CreatedBackups")
  createdRestores              RestoreHistory[]       @relation("CreatedRestores")
  heldBills                    HeldBill[]
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  userCompanies   UserCompany[]
  rolePermissions RolePermission[]
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String
  module    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  loginAt   DateTime @default(now())
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)

  user User @relation(fields: [userId], references: [id])
}

// ─── Multi-Company ─────────────────────────────────────────────

model UserCompany {
  id        Int      @id @default(autoincrement())
  userId    Int
  companyId Int
  roleId    Int
  createdAt DateTime @default(now())

  // Per-user access restrictions (which table types / categories / order types they can use)
  tableTypes        Json?
  productCategories Json?
  orderTypes        Json?

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
}

model Branch {
  id         Int     @id @default(autoincrement())
  companyId  Int
  branchCode String?
  branchName String
  branchType String  @default("Branch")

  // POS Configuration
  connectionString  String?
  branchDisplayName String?
  dayEndAutoClosing Boolean @default(true)
  customField1      String?
  customField2      String?
  rewardPoint       String?
  footerMsg         String?
  website           String?
  billCopy          String?
  openingTime       String?
  closingTime       String?
  graceHours        String?
  gstSummary        Boolean @default(true)
  isBarCodeBill     Boolean @default(true)
  couponPercent     String?
  couponValidity    String?
  indentApproval    Boolean @default(true)
  isDeptKOT         Boolean @default(true)
  unitPriceEdit     Boolean @default(true)
  billNoReset       Boolean @default(true)
  couponVisible     Boolean @default(true)
  orderTypeBill     Boolean @default(true)
  isZomato          Boolean @default(true)
  isSwiggy          Boolean @default(true)
  cloudLogo         String?

  // Contact Info
  contactPerson   String?
  phone           String?
  alternateMobile String?
  email           String?

  // Address
  addr1   String?
  addr2   String?
  city    String?
  state   String?
  country String? @default("India")
  pincode String?

  // Tax
  gstin String?
  pan   String?

  // Logo & Industry
  logo       String?
  industryID String?
  textileGST String?
  fssai      String?

  // Status & Flags
  isHeadOffice    Boolean  @default(false)
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  remarks         String?
  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company               @relation(fields: [companyId], references: [id])
  createdByUser   User?                 @relation("CreatedBranches", fields: [createdByUserId], references: [id])
  updatedByUser   User?                 @relation("UpdatedBranches", fields: [updatedByUserId], references: [id])
  invoices        Invoice[]
  vendorMappings  VendorBranchMapping[]
  dayClosings     DayClosing[]
  advanceOrders   AdvanceOrder[]
  paymentSettings PaymentSettings[]
  productionOuts  ProductionOut[]

  @@unique([companyId, branchName])
  @@unique([companyId, branchCode])
  @@map("branch")
}

// ─── GST ───────────────────────────────────────────────────────

enum GSTMode {
  GST_VISIBLE
  GST_INCLUDED_HIDDEN
  GST_IGST
  NO_GST
  GST_ITEM_WISE
}

model GSTMaster {
  id              Int       @id @default(autoincrement())
  name            String
  totalPercentage Decimal   @db.Decimal(5, 2)
  cgstPercentage  Decimal   @db.Decimal(5, 2)
  sgstPercentage  Decimal   @db.Decimal(5, 2)
  igstPercentage  Decimal   @db.Decimal(5, 2)
  effectiveFrom   DateTime?
  isCustom        Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  products Product[]
  hsnSacs  HSNSac[]

  @@map("gst_master")
}

model HSNSac {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  description      String
  type             String   @default("HSN")
  defaultGstRateId Int?
  isActive         Boolean  @default(true)
  createdByUserId  Int?
  updatedByUserId  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  defaultGstRate GSTMaster? @relation(fields: [defaultGstRateId], references: [id])
  products       Product[]
  createdByUser  User?      @relation("CreatedHSNSacs", fields: [createdByUserId], references: [id])
  updatedByUser  User?      @relation("UpdatedHSNSacs", fields: [updatedByUserId], references: [id])

  @@map("hsn_sac")
}

// ─── Company ───────────────────────────────────────────────────

model Company {
  id          Int     @id @default(autoincrement())
  companyName String
  logo        String?
  address     String
  phone       String
  email       String

  // Branding / theme (per-company UI)
  shortCode        String? // 2-5 char logo tile / header code
  themePrimary     String? // -> --billora-primary
  themePrimaryDark String? // -> --billora-primary-dark
  themeAccent      String? // -> --billora-accent
  themeWarm        String? // -> --billora-warm
  themeBgDark      String? // -> --billora-bg-dark
  themeBgDarker    String? // -> --billora-bg-darker
  themeCardDark    String? // -> --billora-card-dark
  themeNavBg       String? // -> --billora-nav-bg (sidebar)

  gstNumber    String?
  gstStateCode String?
  stateName    String

  gstEnabled Boolean @default(true)
  gstMode    GSTMode @default(GST_VISIBLE)

  roundOffEnabled         Boolean @default(false)
  allowInvoiceGstOverride Boolean @default(false)
  defaultHsnRequired      Boolean @default(false)
  allowCustomGstRate      Boolean @default(false)

  // Extended company info
  panNumber String?
  city      String?
  country   String? @default("India")
  pincode   String?
  website   String?

  // Bank details (for A4 bill print)
  bankAccountHolder String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  bankBranch        String?

  // Billing configuration
  defaultBillingMode   String? @default("WITH_GST")
  invoicePrefix        String? @default("INV")
  estimatePrefix       String? @default("EST")
  creditBillPrefix     String? @default("CR")
  autoNumberGeneration Boolean @default(true)
  decimalPrecision     Int?    @default(2)
  defaultPaymentMode   String? @default("CASH")

  // Inventory configuration
  lowStockAlert        Decimal? @db.Decimal(10, 2)
  negativeStockAllowed Boolean  @default(false)
  defaultWarehouseId   Int?
  barcodeSettings      String?

  // Print configuration
  defaultPrintTemplateId Int?
  paperSize              String? @default("A4")
  printPreviewEnabled    Boolean @default(true)

  // Tax configuration
  defaultGstPercentage Decimal? @db.Decimal(5, 2)
  igstEnabled          Boolean  @default(false)

  // General settings
  currency       String? @default("INR")
  currencySymbol String? @default("₹")
  timeZone       String? @default("Asia/Kolkata")
  dateFormat     String? @default("DD/MM/YYYY")
  financialYear  String?
  language       String? @default("en")

  // License
  licenseDate DateTime?

  // Dynamic list options (per-company, managed in Master Configuration → Lists)
  tableTypes        Json?
  orderTypes        Json?
  productCategories Json?

  createdByUserId Int?
  updatedByUserId Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUser User? @relation("CreatedCompanies", fields: [createdByUserId], references: [id])
  updatedByUser User? @relation("UpdatedCompanies", fields: [updatedByUserId], references: [id])

  branches              Branch[]
  users                 User[]                 @relation("DefaultCompany")
  userCompanies         UserCompany[]
  customers             Customer[]
  products              Product[]
  invoices              Invoice[]
  vendors               Vendor[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  stockOuts             StockOut[]
  stockAudits           StockAudit[]
  indents               Indent[]
  inventoryLedger       InventoryLedger[]
  purchaseInvoices      PurchaseInvoice[]
  vendorPayments        VendorPayment[]
  invoicePayments       InvoicePayment[]
  kitchenOrders         KitchenOrder[]
  printTemplates        PrintTemplate[]
  estimates             Estimate[]
  vendorBranchMappings  VendorBranchMapping[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  dayClosings           DayClosing[]
  advanceOrders         AdvanceOrder[]
  advanceOrderItems     AdvanceOrderItem[]
  paymentSettings       PaymentSettings[]
  students              Student[]
  units                 Unit[]
  productionMappings    ProductionMapping[]
  productionConversions ProductionConversion[]
  productionPlans       ProductionPlan[]
  productionPlanItems   ProductionPlanItem[]
  productionIns         ProductionIn[]
  productionInItems     ProductionInItem[]
  productionOuts        ProductionOut[]
  productionOutItems    ProductionOutItem[]
  wastage               Wastage[]
  wastageItems          WastageItem[]
  walletTransactions    WalletTransaction[]
  waBalance             WABalance?
  waMessages            WAMessage[]
  waBalanceTransactions WABalanceTransaction[]
  waTemplates           WATemplate[]
  waCampaigns           WACampaign[]
  cashCategories        CashCategory[]
  cashAccounts          CashAccount[]
  cashTransactions      CashTransaction[]
  quotes                Quote[]
  accountingInvoices    AccountingInvoice[]
  events                Event[]
  backupSetting         BackupSetting?
  backupHistory         BackupHistory[]
  restoreHistory        RestoreHistory[]
  backupLogs            BackupLog[]
  backupJobs            BackupJob[]
  cloudBackups          CloudBackup[]
  menuAccesses          UserMenuAccess[]
  notifications         Notification[]
  heldBills             HeldBill[]

  @@map("company")
}

// ─── Business ──────────────────────────────────────────────────

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

model Customer {
  id              Int          @id @default(autoincrement())
  companyId       Int
  customerCode    String?
  customerName    String
  phone           String
  alternatePhone  String?
  email           String?
  gstNumber       String?
  panNumber       String?
  address         String?
  addressLine2    String?
  city            String?
  stateName       String
  stateCode       String
  country         String       @default("India")
  pincode         String?
  customerType    CustomerType @default(INDIVIDUAL)
  creditLimit     Decimal      @default(0) @db.Decimal(12, 2)
  creditDays      Int          @default(0)
  wallet          Decimal      @default(0) @db.Decimal(10, 2)
  priceList       String?
  remarks         String?
  isActive        Boolean      @default(true)
  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company            Company             @relation(fields: [companyId], references: [id])
  createdByUser      User?               @relation("CreatedCustomers", fields: [createdByUserId], references: [id])
  updatedByUser      User?               @relation("UpdatedCustomers", fields: [updatedByUserId], references: [id])
  invoices           Invoice[]
  invoicePayments    InvoicePayment[]
  estimates          Estimate[]
  walletTransactions WalletTransaction[]
  campaignItems      WACampaignItem[]

  @@map("customer")
}

// ─── Wallet Transactions ──────────────────────────────────────

model WalletTransaction {
  id              Int      @id @default(autoincrement())
  companyId       Int
  customerId      Int
  cardNumber      String?
  employeeId      String?
  customerName    String?
  mobile          String?
  amount          Decimal  @db.Decimal(10, 2)
  paymentMode     String
  status          String   @default("Completed")
  transactionType String   @default("TOP_UP")
  remarks         String?
  createdByUserId Int?
  createdAt       DateTime @default(now())

  company       Company  @relation(fields: [companyId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
  createdByUser User?    @relation(fields: [createdByUserId], references: [id])

  @@map("wallet_transaction")
}

model Product {
  id            Int     @id @default(autoincrement())
  companyId     Int
  productName   String
  description   String?
  productCode   String?
  barcode       String?
  hsnCode       String?
  hsnSacId      Int?
  category      String?
  unit          String
  purchasePrice Decimal @db.Decimal(10, 2)
  sellingPrice  Decimal @db.Decimal(10, 2)
  gstMasterId   Int
  gstApplicable Boolean @default(true)

  currentStock Decimal @default(0) @db.Decimal(10, 2)
  minimumStock Decimal @default(0) @db.Decimal(10, 2)
  maximumStock Decimal @default(0) @db.Decimal(10, 2)
  reorderLevel Decimal @default(0) @db.Decimal(10, 2)

  isActive Boolean @default(true)

  billLock             Boolean   @default(false)
  billLockedAt         DateTime?
  billLockedByUserId   Int?
  onlineLock           Boolean   @default(false)
  onlineLockedAt       DateTime?
  onlineLockedByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company                @relation(fields: [companyId], references: [id])
  gstMaster           GSTMaster              @relation(fields: [gstMasterId], references: [id])
  hsnSac              HSNSac?                @relation(fields: [hsnSacId], references: [id])
  billLockedByUser    User?                  @relation("BillLockedProducts", fields: [billLockedByUserId], references: [id])
  onlineLockedByUser  User?                  @relation("OnlineLockedProducts", fields: [onlineLockedByUserId], references: [id])
  invoiceItems        InvoiceItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  grnItems            GoodsReceiptItem[]
  stockOutItems       StockOutItem[]
  stockAuditItems     StockAuditItem[]
  indentItems         IndentItem[]
  inventoryLedger     InventoryLedger[]
  kitchenOrderItems   KitchenOrderItem[]
  estimateItems       EstimateItem[]
  mappingProducts     ProductionMapping[]    @relation("MappingProducts")
  mappingItems        ProductionMapping[]    @relation("MappingItems")
  conversionProducts  ProductionConversion[]
  advanceOrderItems   AdvanceOrderItem[]
  productionPlanItems ProductionPlanItem[]
  productionInItems   ProductionInItem[]
  productionOutItems  ProductionOutItem[]
  wastageItems        WastageItem[]

  @@map("product")
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
}

enum InvoiceStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Invoice {
  id              Int           @id @default(autoincrement())
  invoiceNumber   String        @unique
  companyId       Int
  customerId      Int?
  createdByUserId Int
  branchId        Int?
  invoiceDate     DateTime      @default(now())
  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal       @db.Decimal(12, 2)
  gstMode         GSTMode       @default(GST_VISIBLE)
  paymentStatus   PaymentStatus @default(PENDING)
  invoiceStatus   InvoiceStatus @default(DRAFT)
  paymentMode     String?
  cashReceived    Decimal       @default(0) @db.Decimal(12, 2)
  remarks         String?
  salesPerson     String?
  deletedAt       DateTime?
  deletedByUserId Int?
  deleteReason    String?
  estimateId      Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company       Company          @relation(fields: [companyId], references: [id])
  customer      Customer?        @relation(fields: [customerId], references: [id])
  createdByUser User             @relation("CreatedInvoices", fields: [createdByUserId], references: [id])
  deletedByUser User?            @relation("DeletedInvoices", fields: [deletedByUserId], references: [id])
  branch        Branch?          @relation(fields: [branchId], references: [id])
  estimate      Estimate?        @relation(fields: [estimateId], references: [id])
  items         InvoiceItem[]
  payments      InvoicePayment[]
  kitchenOrders KitchenOrder[]

  @@map("invoice")
}

model InvoiceItem {
  id                  Int      @id @default(autoincrement())
  invoiceId           Int
  productId           Int
  productNameSnapshot String
  quantity            Decimal  @db.Decimal(10, 2)
  unitPrice           Decimal  @db.Decimal(10, 2)
  subtotal            Decimal  @db.Decimal(12, 2)
  gstPercentage       Decimal  @db.Decimal(5, 2)
  cgstPercentage      Decimal  @db.Decimal(5, 2)
  sgstPercentage      Decimal  @db.Decimal(5, 2)
  igstPercentage      Decimal  @db.Decimal(5, 2)
  cgstAmount          Decimal  @db.Decimal(12, 2)
  sgstAmount          Decimal  @db.Decimal(12, 2)
  igstAmount          Decimal  @db.Decimal(12, 2)
  taxAmount           Decimal  @db.Decimal(12, 2)
  totalAmount         Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("invoice_item")
}

model HeldBill {
  id              Int      @id @default(autoincrement())
  companyId       Int
  holdNumber      String
  customerId      Int?
  customerName    String?
  items           Json
  subtotal        Decimal  @db.Decimal(12, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal  @db.Decimal(12, 2)
  gstMode         String?
  gstRate         Decimal? @db.Decimal(5, 2)
  paymentMode     String?
  remarks         String?
  salesPerson     String?
  createdByUserId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company @relation(fields: [companyId], references: [id])
  createdByUser User    @relation(fields: [createdByUserId], references: [id])

  @@unique([companyId, holdNumber])
  @@map("held_bill")
}

model InvoicePayment {
  id              Int           @id @default(autoincrement())
  paymentNumber   String
  companyId       Int
  invoiceId       Int
  customerId      Int?
  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  notes           String?
  createdByUserId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company       Company   @relation(fields: [companyId], references: [id])
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  createdByUser User      @relation(fields: [createdByUserId], references: [id])

  @@unique([companyId, paymentNumber])
  @@map("invoice_payment")
}

// ─── Vendor & Purchase Module ──────────────────────────────────

model Vendor {
  id              Int      @id @default(autoincrement())
  companyId       Int
  vendorCode      String
  vendorName      String
  contactPerson   String?
  mobileNumber    String
  alternateMobile String?
  email           String?
  gstNumber       String?
  panNumber       String?
  address         String?
  city            String?
  state           String?
  stateCode       String?
  country         String   @default("India")
  postalCode      String?
  paymentTerms    String?
  creditLimit     Decimal  @default(0) @db.Decimal(12, 2)
  openingBalance  Decimal  @default(0) @db.Decimal(12, 2)
  currentBalance  Decimal  @default(0) @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime @default(now())
